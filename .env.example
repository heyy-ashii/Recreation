# --- Datastore: MongoDB (default) ---
# Required unless you use the Google Sheets datastore below. In Sheets mode this is ignored.
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/ogea
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me

# --- Email OTP (Gmail: create an App Password at https://myaccount.google.com/apppasswords) ---
# If unset, codes are printed to the server log (and returned as devCode outside production).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=ogea.sms@gmail.com
SMTP_PASS=
MAIL_FROM="OGEA <ogea.sms@gmail.com>"

# --- Image uploads (Cloudinary dashboard > API Keys). If unset, admins paste image URLs. ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=ogea-api

# --- Google Sheets datastore (optional, replaces MongoDB entirely) ---
# Leave SHEETS_API_URL empty to keep everything in MongoDB.
# When set, users, OTPs, chats and programs all live in the Sheet. Keep the
# spreadsheet PRIVATE; access is gated by the token below.
# See docs/google-sheets.md. The token must match SHEETS_TOKEN in the Apps Script properties.
SHEETS_API_URL=
SHEETS_API_TOKEN=
SHEETS_TIMEOUT_MS=8000

# --- Optional ---
JWT_EXPIRES_IN=7d
# Comma-separated extra origins allowed to call the API with credentials (not needed when frontend and API share a domain)
CORS_ORIGINS=
# Local dev only
PORT=4000
